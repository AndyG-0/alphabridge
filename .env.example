# Required: protects the API (set a long random string)
ACCESS_TOKEN=change-me
# Required: derives the encryption key for API keys stored via the UI
APP_SECRET=change-me-too
# SEC requires a contact identity for EDGAR requests
EDGAR_IDENTITY=Your Name your@email.com
FRED_API_KEY=
# Optional LLM keys (or set in Settings UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# SQLite by default; e.g. postgresql+psycopg://user:pass@host/db to upgrade
DATABASE_URL=sqlite:////app/data/alphabridge.db
ENABLE_SCHEDULER=1
# Cross-origin allowlist (comma-separated). Empty = same-origin only, which is what the bundled UI needs.
CORS_ORIGINS=
# Failed-auth lockout: this many bad tokens per window (seconds) per client address -> HTTP 429
AUTH_MAX_FAILURES=10
AUTH_WINDOW_SECONDS=60
# Logging: LOG_LEVEL=DEBUG|INFO|WARNING, LOG_FORMAT=text|json (json for log shippers; every line carries request_id)
LOG_LEVEL=INFO
LOG_FORMAT=text
